# Port the InvidiousTube server listens on
PORT=8080
# Bind address
HOST=0.0.0.0
# Your Invidious instance (LAN address recommended)
INVIDIOUS_URL=http://192.168.1.113:3000
# Your invidious-companion instance (without the /companion suffix)
COMPANION_URL=http://192.168.1.113:8282
# Optional extras (set to 0 to disable)
ENABLE_SPONSORBLOCK=1
ENABLE_RYD=1
# Detect YouTube Shorts (the server asks youtube.com/shorts/<id> for short/unknown-length videos)
ENABLE_SHORTS_CHECK=1
# Set to 1 when serving InvidiousTube over HTTPS (marks the login cookie Secure)
COOKIE_SECURE=0
# Public address people reach InvidiousTube at, used for absolute links in Discord/chat embeds.
# Leave empty to use the request's own host (works behind a reverse proxy that sends X-Forwarded-*)
PUBLIC_URL=
# Site name shown on link previews
EMBED_SITE_NAME=YouTube
# Set to 0 to show only the thumbnail in link previews instead of an inline-playable 360p video
EMBED_VIDEO=1
