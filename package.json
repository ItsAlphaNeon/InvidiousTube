{
  "name": "invidioustube",
  "private": true,
  "version": "1.0.0",
  "description": "A YouTube (2024) lookalike frontend for Invidious",
  "type": "module",
  "workspaces": ["web", "server"],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev -w server\" \"npm:dev -w web\"",
    "build": "npm run build -w web",
    "start": "npm start -w server",
    "typecheck": "npm run typecheck -w web"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": { "node": ">=22" }
}
